<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ekundayo Tobiloba Segun | Social Media Manager &amp; Content Strategist</title>
<meta name="description" content="Social Media Manager and Content Strategist helping brands grow through strategic content, storytelling and intentional social media management.">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap">
<style>
:root{--bg:#fafaf8;--surface:#fff;--ink:#121212;--muted:#5d5d5d;--line:#e6e4df;--chip:#f0eee9;--lav:#b9a8ff;--lav-soft:#ece8ff;--accent:#121212;--on-accent:#fff;
--font:"Poppins",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;box-sizing:border-box;
padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#121212;--surface:#1b1b1b;--ink:#f5f4f0;--muted:#b3b1ab;--line:#2b2b2b;--chip:#242424;--lav-soft:#2a2540;--accent:#f5f4f0;--on-accent:#121212}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#121212;--surface:#1b1b1b;--ink:#f5f4f0;--muted:#b3b1ab;--line:#2b2b2b;--chip:#242424;--lav-soft:#2a2540;--accent:#f5f4f0;--on-accent:#121212}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(76px + env(safe-area-inset-top,0px))}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}.w>span{transform:none!important}.js .rv,.js .case .phone,.js .mini .phone{opacity:1!important;transform:none!important;translate:none!important;rotate:none!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);line-height:1.6;overflow-x:hidden;-webkit-text-size-adjust:100%}
img{display:block;max-width:100%;height:auto}
a{color:inherit}
:focus-visible{outline:3px solid #7c5cff;outline-offset:3px;border-radius:8px}
.skip{position:absolute;left:-999px;top:8px;background:var(--accent);color:var(--on-accent);padding:8px 14px;border-radius:8px;z-index:60}
.skip:focus{left:8px}
.wrap{max-width:1120px;margin:0 auto;padding:0 22px}
h1,h2,h3{line-height:1.08;letter-spacing:-.035em;margin:0}
h2{font-size:clamp(2rem,5vw,3.2rem);font-weight:800}
.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 16px}
.eyebrow::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--lav)}
header{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;height:66px;gap:12px}
.logo{font-weight:800;text-decoration:none;letter-spacing:-.03em;display:flex;align-items:center;gap:8px}
.logo i{width:12px;height:12px;border-radius:50%;background:var(--ink);display:inline-block}
nav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0}
nav a{display:block;text-decoration:none;font-size:.88rem;font-weight:500;color:var(--muted);padding:8px 14px;border-radius:999px}
nav a:hover{background:var(--chip);color:var(--ink)}
@media (max-width:760px){nav{display:none}}
.icon-btn{border:1px solid var(--line);background:var(--surface);color:var(--ink);width:42px;height:42px;border-radius:50%;cursor:pointer;font-size:1.1rem}
.btn{display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 24px;border-radius:999px;font-weight:600;text-decoration:none;border:2px solid var(--accent);transition:transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn.primary{background:var(--accent);color:var(--on-accent)}
.btns{display:flex;flex-wrap:wrap;gap:12px}
/* hero */
.hero{position:relative;padding:56px 0 72px}
.hero .wrap{display:grid;gap:40px;align-items:center;grid-template-columns:1.15fr .85fr}
@media (max-width:860px){.hero .wrap{grid-template-columns:1fr}.hero-art{order:-1;max-width:340px;margin:0 auto}}
h1{font-size:clamp(2.6rem,7vw,5rem);font-weight:800}
h1 em{font-style:normal;background:linear-gradient(transparent 62%,var(--lav) 62%);padding:0 .08em}
.lead{max-width:52ch;font-size:1.08rem;color:var(--muted);margin:22px 0 30px}
.hero-art{position:relative}
.oval{border-radius:999px;padding:12px;border:1px solid var(--line);background:var(--surface);box-shadow:0 30px 70px -30px rgba(80,60,160,.45)}
.oval img{border-radius:999px;width:100%;aspect-ratio:3/4;object-fit:cover}
.dot{position:absolute;border-radius:50%;z-index:-1}
.d1{width:120px;height:120px;background:var(--lav);top:-24px;right:-30px}
.d2{width:46px;height:46px;background:var(--ink);bottom:30px;left:-22px}
.badge{position:absolute;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:10px 16px;box-shadow:0 14px 34px -14px rgba(0,0,0,.35);font-size:.78rem;color:var(--muted);animation:float 6s ease-in-out infinite}
.badge b{display:block;font-size:1.35rem;color:var(--ink);letter-spacing:-.03em;line-height:1.1}
.b1{left:-34px;top:20%}
.b2{right:-26px;bottom:14%;animation-delay:-3s}
@media (max-width:520px){.b1{left:-6px}.b2{right:-6px}}
@keyframes float{50%{transform:translateY(-10px)}}
/* marquee */
.marquee{border-block:1px solid var(--line);overflow:hidden;background:var(--surface);padding:16px 0}
.track{display:flex;gap:44px;width:max-content;animation:slide 34s linear infinite;font-weight:600;font-size:1.05rem;white-space:nowrap}
.track span::after{content:"✦";margin-left:44px;color:var(--lav)}
@keyframes slide{to{transform:translateX(-50%)}}
section{padding:88px 0}
/* about */
.about{display:grid;gap:44px;grid-template-columns:.9fr 1.1fr;align-items:center}
@media (max-width:820px){.about{grid-template-columns:1fr}}
.photos{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.photos img{border-radius:26px;width:100%;aspect-ratio:3/4.2;object-fit:cover}
.photos img:last-child{margin-top:36px}
.about p{color:var(--muted);font-size:1.05rem;max-width:56ch}
.about .big{color:var(--ink);font-size:clamp(1.3rem,2.6vw,1.8rem);font-weight:600;letter-spacing:-.02em;line-height:1.35}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:30px}
.stat{background:var(--lav-soft);border-radius:20px;padding:18px}
.stat b{display:block;font-size:1.8rem;font-weight:800;letter-spacing:-.03em;line-height:1.1}
.stat span{font-size:.8rem;color:var(--muted)}
/* work */
.case{display:grid;gap:36px;grid-template-columns:1fr 1fr;align-items:center;padding:34px;border:1px solid var(--line);background:var(--surface);border-radius:36px;margin-top:26px}
.case:nth-of-type(even) .shots{order:-1}
@media (max-width:860px){.case{grid-template-columns:1fr;padding:22px}.case .shots,.case:nth-of-type(even) .shots{order:-1}}
.client{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.client img{width:48px;height:48px;border-radius:50%;object-fit:cover;border:1px solid var(--line)}
.client small{display:block;font-size:.75rem;letter-spacing:.12em;color:var(--muted);font-weight:600}
.client h3{font-size:1.4rem}
.tags{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:0 0 14px;list-style:none}
.tags li{background:var(--chip);border-radius:999px;padding:3px 12px;font-size:.76rem;font-weight:500}
.case p{color:var(--muted);margin:0 0 14px}
.case ul.res{margin:0 0 20px;padding-left:18px;font-size:.93rem}
.case ul.res li{margin:5px 0}
.metric{font-size:clamp(2rem,4.5vw,3rem);font-weight:800;letter-spacing:-.04em;line-height:1}
.metric small{display:block;font-size:.82rem;font-weight:500;color:var(--muted);letter-spacing:0;margin-top:6px}
.shots{display:flex;justify-content:center;gap:14px;align-items:flex-start;background:var(--lav-soft);border-radius:26px;padding:26px 18px;overflow:hidden}
.phone{border:5px solid var(--ink);border-radius:26px;overflow:hidden;width:min(46%,210px);background:#fff;box-shadow:0 18px 40px -18px rgba(0,0,0,.5)}
.phone:nth-child(2){margin-top:34px}
.mini{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));margin-top:26px}
.mini article{border:1px solid var(--line);background:var(--surface);border-radius:28px;padding:24px;display:flex;flex-direction:column;gap:6px}
.mini .shots{padding:16px;margin-bottom:12px;border-radius:20px}
.mini .phone{width:min(55%,170px)}
.mini .phone:nth-child(2){margin-top:0}
.mini h3{font-size:1.2rem}
.mini p{margin:0 0 8px;color:var(--muted);font-size:.93rem}
.mini .metric{font-size:1.6rem;margin-top:auto}
/* reviews */
.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));margin-top:30px}
figure{margin:0;border:1px solid var(--line);background:var(--surface);border-radius:28px;padding:26px}
figure::before{content:"“";display:block;font-size:4rem;line-height:.6;color:var(--lav);font-weight:800}
blockquote{margin:0;font-size:.96rem}
figcaption{display:flex;align-items:center;gap:12px;margin-top:20px;font-weight:700}
figcaption img{width:44px;height:44px;border-radius:50%;object-fit:cover;border:1px solid var(--line)}
/* skills */
.skills{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));margin-top:30px}
.panel{border:1px solid var(--line);background:var(--surface);border-radius:28px;padding:26px}
.panel h3{font-size:1.1rem;margin-bottom:14px}
.panel .tags{margin:0}
.panel .tags li{background:var(--lav-soft)}
/* contact */
.cta{background:var(--ink);color:var(--bg);border-radius:40px;padding:clamp(30px,6vw,64px);position:relative;overflow:hidden}
.cta::after{content:"";position:absolute;width:280px;height:280px;border-radius:50%;background:var(--lav);right:-80px;top:-90px;opacity:.9}
.cta h2{max-width:14ch;position:relative;z-index:1}
.cta ul{list-style:none;margin:30px 0 0;padding:0;max-width:520px;position:relative;z-index:1}
.cta li{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:14px 0;border-bottom:1px solid color-mix(in srgb,var(--bg) 22%,transparent)}
.cta li span{opacity:.7}
.cta a{font-weight:600;overflow-wrap:anywhere}
.cta .btn{border-color:var(--bg);color:var(--bg);margin-top:26px;position:relative;z-index:1}
.cta .btn.primary{background:var(--bg);color:var(--ink)}
footer{padding:30px 0 50px;color:var(--muted);font-size:.85rem}
.js .rv{opacity:0;transform:translateY(24px);transition:opacity .7s,transform .7s}
.js .rv.in{opacity:1;transform:none}

.prog{position:fixed;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--lav),#ff9a8b);transform-origin:left;transform:scaleX(0);z-index:70}
.hdr-r{display:flex;align-items:center;gap:10px}
.btn.sm{min-height:40px;padding:0 18px;font-size:.85rem}
@media (max-width:520px){.btn.sm{display:none}}
.hero .wrap{position:relative;z-index:1}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(520px circle at var(--mx,72%) var(--my,28%),color-mix(in srgb,var(--lav) 38%,transparent),transparent 65%);pointer-events:none}
.w{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .04em .12em}
.w>span{display:inline-block;transform:translateY(115%);animation:up .95s cubic-bezier(.2,.8,.2,1) forwards}
.w:nth-child(2)>span{animation-delay:.12s}.w:nth-child(3)>span{animation-delay:.24s}
@keyframes up{to{transform:none}}
@keyframes fade{from{opacity:0;transform:translateY(14px)}}
@keyframes pop{from{opacity:0;transform:scale(.88) rotate(-3deg)}}
.hero .eyebrow,.hero .lead,.hero .btns{animation:fade .9s .5s both}
.oval{animation:pop 1.1s .2s cubic-bezier(.2,.8,.2,1) both}
.d1{transform:translateY(calc(var(--sy,0)*-.12px))}.d2{transform:translateY(calc(var(--sy,0)*.08px))}
.marquee:hover .track{animation-play-state:paused}
.phone{transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .25s ease-out}
.js .case .phone,.js .mini .phone{opacity:0;translate:0 50px;rotate:5deg;transition:opacity .8s,translate .9s cubic-bezier(.2,.8,.2,1),rotate .9s,transform .25s ease-out}
.js .in .phone{opacity:1;translate:0 0;rotate:0deg}
.js .in .phone:nth-child(2){transition-delay:.15s,.15s,.15s,0s}
.case,.mini article,.panel,figure{transition:box-shadow .35s,border-color .35s}
.case:hover,.mini article:hover,.panel:hover,figure:hover{border-color:var(--lav);box-shadow:0 24px 60px -30px rgba(120,90,255,.55)}
.vlink{display:inline-flex;align-items:center;gap:6px;margin-top:18px;font-weight:600;font-size:.9rem;text-decoration:none;border-bottom:2px solid var(--lav);padding-bottom:2px;transition:gap .2s}
.vlink:hover{gap:11px}
.fab{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:40;display:flex;align-items:center;gap:10px;background:#075e54;color:#fff;font-weight:500;font-size:.92rem;text-decoration:none;padding:8px 20px 8px 8px;border-radius:999px;box-shadow:0 14px 34px -10px rgba(37,211,102,.7);transform:translateY(90px);opacity:0;transition:transform .4s,opacity .4s}
.fab.show{transform:none;opacity:1}
.ini{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--ink);color:var(--bg);font-weight:800;font-size:.8rem;flex:none}
.photos{grid-template-columns:1fr}.photos img{aspect-ratio:4/5;object-position:50% 80%}.photos img:last-child{margin-top:0}
.vids{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));margin-top:30px}
.vid{display:flex;align-items:center;gap:16px;padding:22px;border:1px solid var(--line);background:var(--surface);border-radius:26px;text-decoration:none;transition:border-color .3s,box-shadow .3s}
.vid:hover{border-color:var(--lav);box-shadow:0 24px 60px -30px rgba(120,90,255,.55)}
.play{flex:none;width:54px;height:54px;border-radius:50%;background:var(--lav);color:#121212;display:grid;place-items:center;animation:pulse 2.4s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(185,168,255,.7)}100%{box-shadow:0 0 0 18px rgba(185,168,255,0)}}
.vid b{display:block}.vid small{color:var(--muted)}
.photos{display:block;position:relative;max-width:420px;margin:0 auto;padding-bottom:64px}
.photos::before{content:"";position:absolute;width:62%;aspect-ratio:1;border-radius:50%;background:var(--lav);top:-22px;left:-18px;z-index:-1}
.photos .main{display:block;width:84%;margin-left:auto;aspect-ratio:4/5;object-fit:cover;object-position:50% 80%;border-radius:999px 999px 28px 28px;box-shadow:0 30px 60px -30px rgba(60,30,120,.55)}
.photos .side{position:absolute;left:0;bottom:0;width:46%;aspect-ratio:3/4;object-fit:cover;margin:0;border-radius:24px;border:6px solid var(--bg);box-shadow:0 20px 40px -18px rgba(0,0,0,.5);rotate:-6deg;transition:rotate .4s,scale .4s;animation:float 6s ease-in-out infinite}
.photos:hover .side{rotate:0deg;scale:1.04}
.vwrap{grid-column:1/-1}.vt{font-weight:700;margin-bottom:12px}.vwrap .vids{margin-top:0}
.foot{display:flex;justify-content:space-between;align-items:center;gap:12px 24px;flex-wrap:wrap}
.credit{font-weight:600;text-decoration:none;color:var(--ink);border-bottom:2px solid var(--lav);padding-bottom:2px}
.credit:hover{background:var(--lav-soft)}
.phone{position:relative}
#work .phone{cursor:zoom-in}
.tag{position:absolute;left:8px;top:8px;z-index:2;font-size:.66rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:999px;background:var(--ink);color:var(--bg)}
.tag.before{background:rgba(18,18,18,.88);color:#fff}
.tag.after{background:var(--lav);color:#121212}
.shots.three{gap:10px;padding:22px 12px}
.shots.three .phone{width:31%;border-width:4px;border-radius:20px}
.metrics{display:flex;flex-wrap:wrap;gap:18px 40px}
.metrics .metric{font-size:clamp(1.8rem,3.6vw,2.4rem)}
.lb{position:fixed;inset:0;z-index:100;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:calc(16px + env(safe-area-inset-top,0px)) 12px calc(16px + env(safe-area-inset-bottom,0px));background:rgba(10,10,10,.93);backdrop-filter:blur(6px);animation:fade .25s both}
.lb[hidden]{display:none}
.lb figure{margin:0;border:0;background:none;padding:0;display:grid;justify-items:center;gap:12px;min-width:0}
.lb figure::before{content:none}
.lb img{max-width:100%;max-height:78vh;border-radius:18px;box-shadow:0 30px 80px rgba(0,0,0,.6);animation:pop .35s cubic-bezier(.2,.8,.2,1) both}
.lb figcaption{display:block;margin:0;color:#ddd;font-size:.85rem;font-weight:400;text-align:center;max-width:60ch}
.lb button{border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.1);color:#fff;width:46px;height:46px;border-radius:50%;font-size:1.5rem;cursor:pointer}
.lb button:hover{background:rgba(255,255,255,.22)}
.lb-x{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));right:14px;z-index:2}
@media (max-width:560px){.lb{grid-template-columns:1fr}.lb-p,.lb-n{display:none}}
.wa{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#25d366;flex:none}
.wa svg{width:20px;height:20px;fill:#fff}
.logo{gap:12px}
.mark{position:relative;width:42px;height:42px;flex:none}
.mark::before{content:"";position:absolute;inset:-3px;border-radius:50%;background:conic-gradient(var(--lav),#ff9a8b,#7c5cff,var(--lav));animation:spin 3.5s linear infinite}
.mark img{position:relative;display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;border:2px solid var(--bg);animation:breathe 4s ease-in-out infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes breathe{50%{transform:scale(1.06)}}
footer{padding-bottom:0}
.credit-bar{display:flex;align-items:center;justify-content:center;gap:10px;margin:18px auto 0;max-width:1120px;padding:16px 22px calc(22px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line);color:var(--ink);text-decoration:none;font-size:.88rem;text-align:left}
.credit-bar b{font-size:.95rem;font-weight:700;letter-spacing:-.01em;border-bottom:2px solid var(--lav)}
.credit-bar small{color:var(--muted);font-size:.85rem}
.credit-bar small::before{content:"·";margin:0 8px}
.credit-bar:hover b{background:var(--lav-soft)}
.credit-bar .wa{width:26px;height:26px}
.credit-bar .wa svg{width:15px;height:15px}
.fab.hide{opacity:0;pointer-events:none;transform:translateY(90px)}
.steps{list-style:none;padding:0;margin:32px 0 30px;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr))}
.steps li{position:relative;border:1px solid var(--line);background:var(--surface);border-radius:26px;padding:26px 24px;overflow:hidden}
.steps li:nth-child(2){transition-delay:.1s}.steps li:nth-child(3){transition-delay:.2s}.steps li:nth-child(4){transition-delay:.3s}
.steps .n{position:absolute;right:16px;top:8px;font-size:3.2rem;font-weight:800;letter-spacing:-.05em;color:var(--lav);opacity:.55;line-height:1}
.steps svg{width:36px;height:36px;margin-bottom:16px;stroke:var(--ink);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.js .steps svg *{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.3s ease .25s}
.js .steps li.in svg *{stroke-dashoffset:0}
.steps h3{font-size:1.25rem;margin-bottom:6px}
.steps p{margin:0;color:var(--muted);font-size:.93rem}
.app{display:grid;justify-items:center;gap:8px;text-decoration:none;color:inherit}
.app i{display:grid;place-items:center;width:64px;height:64px;border-radius:18px;box-shadow:0 10px 24px -10px rgba(0,0,0,.6);transition:transform .25s}
.app i svg{width:30px;height:30px}
.app:hover i{transform:translateY(-6px) rotate(-3deg)}
.app span{font-size:.78rem;font-weight:500;opacity:.85}
i.ig{background:radial-gradient(circle at 30% 107%,#fdf497 0,#fdf497 5%,#fd5949 45%,#d6249f 60%,#285aeb 90%)}
i.x{background:#000;box-shadow:0 10px 24px -10px rgba(0,0,0,.6),inset 0 0 0 1px #333}
i.wat{background:#25d366}
i.mail{background:linear-gradient(#4aa3ff,#1c6ef2)}
i.call{background:#7c5cff}
.app.sm i{width:44px;height:44px;border-radius:13px}
