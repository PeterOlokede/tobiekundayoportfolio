<script>
(function(){
  var root=document.documentElement,btn=document.getElementById("theme");
  root.classList.add("js");
  function apply(t){root.setAttribute("data-theme",t);btn.setAttribute("aria-pressed",String(t==="dark"))}
  var saved=null;try{saved=localStorage.getItem("theme")}catch(e){}
  var dark=window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches;
  apply(saved||(dark?"dark":"light"));
  btn.addEventListener("click",function(){var n=root.getAttribute("data-theme")==="dark"?"light":"dark";apply(n);try{localStorage.setItem("theme",n)}catch(e){}});
  document.getElementById("yr").textContent=new Date().getFullYear();
  var els=document.querySelectorAll(".rv");
  if("IntersectionObserver" in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target)}})},{threshold:.12});
    els.forEach(function(el){io.observe(el)});
  }else{els.forEach(function(el){el.classList.add("in")})}
})();
</script>
<script>
(function(){
 var reduce=true,root=document.documentElement,
 prog=document.getElementById("prog"),fab=document.getElementById("fab"),tick=false;
 function onScroll(){var h=root.scrollHeight-innerHeight,y=scrollY;prog.style.transform="scaleX("+(h>0?y/h:0)+")";root.style.setProperty("--sy",y);fab.classList.toggle("show",y>600);tick=false}
 addEventListener("scroll",function(){if(!tick){tick=true;requestAnimationFrame(onScroll)}},{passive:true});onScroll();
 if(reduce)return;
 function fmt(el,v){el.textContent=v.toFixed(+el.dataset.dec||0)+(el.dataset.suf||"")}
 if("IntersectionObserver" in window){
  var co=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;co.unobserve(e.target);
   var el=e.target,to=+el.dataset.to,t0=null;
   requestAnimationFrame(function step(t){t0=t0||t;var p=Math.min((t-t0)/1400,1);fmt(el,to*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(step)})})},{threshold:.6});
  document.querySelectorAll("[data-to]").forEach(function(n){co.observe(n)});
 }
 if(!matchMedia("(hover:hover)").matches)return;
 var hero=document.querySelector(".hero");
 hero.addEventListener("pointermove",function(e){var r=hero.getBoundingClientRect();hero.style.setProperty("--mx",(e.clientX-r.left)+"px");hero.style.setProperty("--my",(e.clientY-r.top)+"px")});
 document.querySelectorAll(".phone").forEach(function(p){
  p.addEventListener("pointermove",function(e){var r=p.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;p.style.setProperty("--ry",x*14+"deg");p.style.setProperty("--rx",-y*14+"deg")});
  p.addEventListener("pointerleave",function(){p.style.setProperty("--ry","0deg");p.style.setProperty("--rx","0deg")})});
 document.querySelectorAll(".btn").forEach(function(b){
  b.addEventListener("pointermove",function(e){var r=b.getBoundingClientRect();b.style.translate=((e.clientX-r.left-r.width/2)*.18)+"px "+((e.clientY-r.top-r.height/2)*.3)+"px"});
  b.addEventListener("pointerleave",function(){b.style.translate=""})});
})();
</script>
<script>
(function(){
 var lb=document.getElementById("lb"),img=lb.querySelector("img"),cap=lb.querySelector("figcaption"),
 items=[].slice.call(document.querySelectorAll("#work .phone")),cur=0,last=null,x0=null;
 items.forEach(function(p,i){
  var im=p.querySelector("img");p.setAttribute("role","button");p.setAttribute("tabindex","0");p.setAttribute("aria-label","View larger: "+im.alt);
  p.addEventListener("click",function(){open(i)});
  p.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();open(i)}});
 });
 function show(i){cur=(i+items.length)%items.length;var p=items[cur],im=p.querySelector("img"),t=p.querySelector(".tag");
  img.src=im.src;img.alt=im.alt;cap.textContent=(t?t.textContent+": ":"")+im.alt}
 function open(i){last=document.activeElement;show(i);lb.hidden=false;document.documentElement.style.overflow="hidden";lb.querySelector(".lb-x").focus()}
 function close(){lb.hidden=true;document.documentElement.style.overflow="";if(last)last.focus()}
 lb.querySelector(".lb-x").addEventListener("click",close);
 lb.querySelector(".lb-p").addEventListener("click",function(){show(cur-1)});
 lb.querySelector(".lb-n").addEventListener("click",function(){show(cur+1)});
 lb.addEventListener("click",function(e){if(e.target===lb)close()});
 document.addEventListener("keydown",function(e){if(lb.hidden)return;
  if(e.key==="Escape")close();else if(e.key==="ArrowLeft")show(cur-1);else if(e.key==="ArrowRight")show(cur+1);
  else if(e.key==="Tab"){var b=lb.querySelectorAll("button"),f=b[0],l=b[b.length-1];
   if(e.shiftKey&&document.activeElement===f){e.preventDefault();l.focus()}else if(!e.shiftKey&&document.activeElement===l){e.preventDefault();f.focus()}}});
 lb.addEventListener("touchstart",function(e){x0=e.touches[0].clientX},{passive:true});
 lb.addEventListener("touchend",function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;if(Math.abs(dx)>50)show(cur+(dx<0?1:-1));x0=null});
})();
</script>
